def get_saved_music(user_id):

    conn = get_db()

    rows = conn.execute("""
        SELECT
            id,
            file_id,
            title,
            artist
        FROM audios
        WHERE user_id=?
        ORDER BY id DESC
        LIMIT 30
    """, (
        user_id,
    )).fetchall()

    conn.close()

    return rows


